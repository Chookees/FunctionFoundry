<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>FunctionFoundry.Observability</RootNamespace>
    <AssemblyName>FunctionFoundry.Observability</AssemblyName>
    <PackageId>FunctionFoundry.Observability</PackageId>
    <Description>Logging-framework-neutral observability primitives: sensitive-data redaction, stable event fingerprinting, adaptive sampling, and burst coalescing.</Description>
