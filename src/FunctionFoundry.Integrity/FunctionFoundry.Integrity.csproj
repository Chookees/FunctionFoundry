<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>FunctionFoundry.Integrity</RootNamespace>
    <AssemblyName>FunctionFoundry.Integrity</AssemblyName>
    <PackageId>FunctionFoundry.Integrity</PackageId>
