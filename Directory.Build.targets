<Project>
  <!-- Repository-wide targets for FunctionFoundry packages. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReadmeFile Condition="'$(PackageReadmeFile)' == ''">PACKAGE.md</PackageReadmeFile>
    <EnablePackageValidation Condition="'$(EnablePackageValidation)' == ''">true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true' and Exists('$(MSBuildProjectDirectory)/PACKAGE.md')">
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true' and Exists('$(MSBuildThisFileDirectory)NOTICE')">
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true' and Exists('$(MSBuildThisFileDirectory)LICENSE')">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="ValidateNoForbiddenPackageNames" BeforeTargets="Build"
          Condition="'$(IsPackable)' == 'true'">
    <Error
      Condition="$(PackageId.EndsWith('.All')) or $(PackageId.EndsWith('.Common')) or $(PackageId.EndsWith('.Utils')) or $(PackageId.EndsWith('.Helpers'))"
      Text="Forbidden aggregate/utility package id: $(PackageId)" />
  </Target>
</Project>
